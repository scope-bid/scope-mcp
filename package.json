{
  "name": "@scope-bid/mcp-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Scope's vertical MCP servers. Shared core + per-vertical wrappers.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/node_modules",
    "eval": "tsx tests/evals/runner.ts",
    "eval:live": "tsx tests/evals/runner.ts --live"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "tsx": "^4.19.0"
  }
}
